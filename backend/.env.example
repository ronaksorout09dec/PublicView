# =========================================================
# Prop-OS — Ultimate Property OS — .env.example
# Phase 2 — Security + RBAC + Redis + S3
# =========================================================

# Database - PostgreSQL (prod) with H2 fallback (dev)
DATABASE_URL=jdbc:postgresql://localhost:5432/propos
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DDL_AUTO=update
FLYWAY_ENABLED=false

# JWT — Generate: openssl rand -base64 64
JWT_SECRET=U2VjcmV0S2V5Rm9yUHJvcE9TU3VwZXJTZWN1cmVNb25vbGl0aHlCdWlsZGluZ1NlY3JldEtleVRoYXRJc1ZlcnlMb25nQW5kU2VjdXJlMTIzNDU2Nzg5MDEyMw==
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXP_MS=604800000

# Redis — Cache, Session, Pub/Sub, PIN TTL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TYPE=simple
# For prod with Redis: CACHE_TYPE=redis

# AWS S3 — Documents (KYC, Lease PDFs, Ticket Media, Invoices)
AWS_S3_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=propos-documents-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ollama — Legacy Voice Agent
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_TIMEOUT=60000

# CORS — enterprise preview hosts
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://*.e2b.app

# Voice
VOICE_STT_PROVIDER=whisper
VOICE_TTS_PROVIDER=kokoro
VOICE_TTS_FALLBACK=piper
